import ActionEngine from '../../../admin-platform-v1.5.1-full/engines/action-engine.js'
import AjaxAdapter from '../../../admin-platform-v1.5.1-full/adapters/ajax-adapter.js'
import Alert from '../../../admin-platform-v1.5.1-full/adapters/alert-adapter.js'

export default {
    init() {
        ActionEngine.register('delete-{{ module-slug }}', async (id) => {
            if (!confirm('Delete item?')) return
            await AjaxAdapter.delete(`/{{ module-slug }}/${id}`)
            Alert.success('Item deleted')
        })
    }
}
