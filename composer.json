{
    "name": "hadii/laramina",
    "version": "1.1.0",
    "description": "Modular admin panel for Laravel 10/11/12 with dynamic JS modules and engine-based architecture",
    "type": "laravel-package",
    "license": "MIT",
    "authors": [
        {
            "name": "hadii",
            "email": "hadi78m@email.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12|^13"
    },
    "autoload": {
        "psr-4": {
            "Laramina\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laramina\\LaraminaServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^10.0",
        "laravel/pint": "^1.30"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "classmap": [
            "tests/Models/AppUserStub.php",
            "tests/Models/AppControllerStub.php"
        ]
    },
    "scripts": {
        "check-version": "php scripts/check-version.php",
        "post-install-cmd": [
            "git config core.hooksPath .githooks"
        ],
        "post-update-cmd": [
            "git config core.hooksPath .githooks"
        ]
    }
}
